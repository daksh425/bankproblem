---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { getEntry, getEntries } from 'astro:content';
import { Image } from 'astro:assets';
import { SITE, CATEGORY_MAP } from '@/config';
import { readTime } from '@/lib/cover';
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Avatar from '@/components/Avatar.astro';
import Share from '@/components/Share.astro';
import Cover from '@/components/Cover.astro';
import Toc from '@/components/Toc.astro';
import Faq from '@/components/Faq.astro';
import Cta from '@/components/Cta.astro';
import Sources from '@/components/Sources.astro';
import AdSlot from '@/components/AdSlot.astro';
import PostCard from '@/components/PostCard.astro';

interface Props { entry: CollectionEntry<'problems'>; headings: MarkdownHeading[] }
const { entry, headings } = Astro.props;
const d = entry.data;

const cat = CATEGORY_MAP[d.category];
const path = `/${d.category}/${entry.id}`;
const url = new URL(path, SITE.url).href;
const mins = readTime(entry.body);

const author = await getEntry(d.author);
if (!author) throw new Error(`Missing author for ${entry.id}`);
const reviewer = d.reviewer ? await getEntry(d.reviewer) : undefined;

const related = d.related.length
  ? (await getEntries(d.related.map((id) => ({ collection: 'problems' as const, id })))).filter(Boolean)
  : [];

const fmt = (x: Date) => x.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
const iso = (x: Date) => x.toISOString().slice(0, 10);
const changed = d.updated.getTime() !== d.published.getTime();

const person = (a: NonNullable<typeof author>) => ({
  '@type': 'Person',
  name: a.data.name,
  jobTitle: a.data.role,
  description: a.data.bio,
  url: new URL(`/authors/${a.id}`, SITE.url).href,
  ...(a.data.links.length ? { sameAs: a.data.links.map((l) => l.url) } : {}),
});

const schema: unknown[] = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', SITE.url).href },
      { '@type': 'ListItem', position: 3, name: cat.name, item: new URL(`/${cat.slug}`, SITE.url).href },
      { '@type': 'ListItem', position: 4, name: d.title, item: url },
    ],
  },
  {
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: d.seoTitle ?? d.title,
    name: d.title,
    description: d.description,
    inLanguage: SITE.lang,
    datePublished: d.published.toISOString(),
    dateModified: d.updated.toISOString(),
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    author: person(author),
    ...(reviewer ? { reviewedBy: person(reviewer) } : {}),
    publisher: { '@id': `${SITE.url}/#org` },
    articleSection: cat.name,
    wordCount: (entry.body ?? '').split(/\s+/).filter(Boolean).length,
    timeRequired: `PT${mins}M`,
    ...(d.sources.length
      ? {
          citation: d.sources.map((s) => ({
            '@type': 'CreativeWork',
            name: s.label,
            url: s.url,
            ...(s.issuer ? { publisher: { '@type': 'Organization', name: s.issuer } } : {}),
          })),
        }
      : {}),
  },
];

if (d.faqs.length) {
  schema.push({
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: d.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}

if (d.steps?.length) {
  schema.push({
    '@type': 'HowTo',
    '@id': `${url}#howto`,
    name: d.title,
    ...(d.answer ? { description: d.answer } : {}),
    step: d.steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.name, text: s.text })),
  });
}
---
<Base
  title={d.seoTitle ?? d.title}
  description={d.description}
  path={path}
  ogType="article"
  noindex={d.draft}
  schema={schema}
>
  <article class="post">
    <div class="shell post-head">
      <Breadcrumbs items={[
        { label: 'Blog', href: '/blog' },
        { label: cat.name, href: `/${cat.slug}` },
        { label: d.title },
      ]} />

      <h1>{d.title}</h1>
      <p class="dek">{d.description}</p>

      <div class="post-meta">
        <div class="who">
          <Avatar name={author.data.name} />
          <div>
            <a class="nm" href={`/authors/${author.id}`}>{author.data.name}</a>
            <div class="sub">
              <time datetime={iso(changed ? d.updated : d.published)}>
                {changed ? `Updated ${fmt(d.updated)}` : fmt(d.published)}
              </time>
              <span aria-hidden="true">·</span>
              <span>{mins} min read</span>
              {d.reviewed && (
                <>
                  <span aria-hidden="true">·</span>
                  <span class="checked">Rules checked {fmt(d.reviewed)}</span>
                </>
              )}
            </div>
          </div>
        </div>
        <div class="meta-right">
          <a class="pill brandpill" href={`/${cat.slug}`}>{cat.name}</a>
          <Share url={url} title={d.title} />
        </div>
      </div>
    </div>

    <div class="shell post-cover">
      {d.cover ? (
        <Image src={d.cover} alt={d.coverAlt ?? ''} width={1200} height={720} loading="eager" class="cover cover-hero" />
      ) : (
        <Cover title={d.title} slug={entry.id} category={d.category} variant="hero" />
      )}
    </div>

    <div class="shell post-body">
      {d.affiliate && (
        <p class="disclosure">
          Some links on this page are affiliate links. If you apply through one we may be paid a
          commission, at no cost to you. It does not change what we recommend.
          <a href="/affiliate-disclosure"> How this works</a>.
        </p>
      )}

      <Toc headings={headings} />

      {d.answer && (
        <div class="answer">
          <div class="eyebrow">Short answer</div>
          <p>{d.answer}</p>
        </div>
      )}

      {d.cta && <Cta />}

      <AdSlot slot="" label="above article" />

      <div class="prose">
        <slot />
      </div>

      {d.faqs.length > 0 && <Faq items={d.faqs} />}
      {d.sources.length > 0 && <Sources items={d.sources} />}

      <div class="post-foot">
        <div>
          <div class="eyebrow">Share this</div>
          <Share url={url} title={d.title} />
        </div>
        <a class="btn ghost" href={`/${cat.slug}`}>More on {cat.name.toLowerCase()} &rarr;</a>
      </div>

      <AdSlot slot="" label="end of article" />
    </div>

    {related.length > 0 && (
      <div class="shell">
        <section class="also">
          <h2>You may also like</h2>
          <div class="pgrid">
            {related.slice(0, 3).map((p) => <PostCard post={p} />)}
          </div>
        </section>
      </div>
    )}
  </article>
</Base>
