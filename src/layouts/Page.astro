---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';

interface Props { title: string; description: string; path: string; lede?: string; noindex?: boolean }
const { title, description, path, lede, noindex } = Astro.props;
---
<Base title={title} description={description} path={path} noindex={noindex}>
  <div class="shell" style="padding-block:1.25rem 3.5rem">
    <Breadcrumbs items={[{ label: title }]} />
    <header class="stack" style="gap:.8rem;margin:1.5rem 0 2rem;max-width:46rem">
      <h1>{title}</h1>
      {lede && <p class="muted" style="font-size:1.08rem">{lede}</p>}
    </header>
    <div class="prose"><slot /></div>
  </div>
</Base>
