---
interface Props { url: string; title: string }
const { url, title } = Astro.props;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);

// WhatsApp first: in India it carries more sharing than every other network combined.
const links = [
  { label: 'WhatsApp', href: `https://wa.me/?text=${t}%20${u}`, d: 'M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.1-.7.1l-.9 1.1c-.2.2-.3.2-.6.1-1.5-.6-2.7-1.8-3.3-3.2-.1-.3 0-.4.1-.6l.9-1c.1-.2.1-.4 0-.6l-1-2.3c-.2-.5-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-1.1 1.1-1.2 2.6-.4 4.2.9 1.9 2.5 3.5 4.4 4.4 1.7.8 3.2.7 4.3-.4.3-.3.4-.7.4-.9v-.6c0-.2 0-.4-.2-.5zM12 2a10 10 0 00-8.7 15L2 22l5.2-1.3A10 10 0 1012 2z' },
  { label: 'X', href: `https://twitter.com/intent/tweet?url=${u}&text=${t}`, d: 'M18.2 2h3.3l-7.2 8.3L22.8 22h-6.6l-5.2-6.8L5.1 22H1.8l7.7-8.8L1.4 2h6.8l4.7 6.2zm-1.2 18h1.8L7.1 3.9H5.2z' },
  { label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`, d: 'M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 21V9h4v12H3zm7 0V9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.76V21h-4v-5.6c0-1.34-.03-3.07-1.9-3.07-1.9 0-2.2 1.46-2.2 2.97V21h-4z' },
  { label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}`, d: 'M22 12a10 10 0 10-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0022 12z' },
];
---
<div class="share">
  <button type="button" class="share-btn copy" data-url={url}>
    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <rect x="9" y="9" width="12" height="12" rx="2"></rect>
      <path d="M5 15V5a2 2 0 012-2h10"></path>
    </svg>
    <span class="lbl">Copy link</span>
  </button>
  {links.map((l) => (
    <a class="share-btn" href={l.href} target="_blank" rel="noopener nofollow" aria-label={`Share on ${l.label}`}>
      <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d={l.d} /></svg>
    </a>
  ))}
</div>

<script is:inline>
  document.addEventListener('click', function (e) {
    var btn = e.target instanceof Element ? e.target.closest('.share-btn.copy') : null;
    if (!btn) return;
    var span = btn.querySelector('.lbl');
    var url = btn.getAttribute('data-url') || location.href;
    function done(ok) {
      if (!span) return;
      span.textContent = ok ? 'Copied' : 'Press Ctrl+C';
      btn.classList.toggle('ok', ok);
      setTimeout(function () { span.textContent = 'Copy link'; btn.classList.remove('ok'); }, 2000);
    }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(url).then(function () { done(true); }, function () { done(false); });
    } else {
      done(false);
    }
  });
</script>
