---
import { SITE, NAV } from '@/config';
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="shell bar">
    <a class="brand" href="/">
      <span class="mark" aria-hidden="true">B</span>
      <span>{SITE.name}</span>
    </a>

    <nav class="site-nav nav-scroll" aria-label="Categories">
      {NAV.map((item) => (
        <a
          href={item.href}
          aria-current={here === item.href || here.startsWith(item.href + '/') ? 'true' : undefined}
        >{item.label}</a>
      ))}
    </nav>

    <button class="theme-btn" type="button" id="theme-toggle" aria-label="Switch colour theme">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
    </button>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      // The site is light by design and does not follow the OS setting,
      // so an unset theme always means light.
      var root = document.documentElement;
      var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
  })();
</script>
